# Database connection string
DATABASE_URL=your_mongodb_connection_string_here

# Session secret for Express session
SESSION_SECRET=your_session_secret_here
JWT_SECRET=your_jwt_secret_here

# Port for the server to listen on
PORT=3001

# Client URL
CLIENT_URL=http://localhost:5173

# Add your Cloudinary credentials here
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Node environment (development or production)
NODE_ENV=production

# Comma-separated list of allowed origins for CORS (only used in production)
# Example: https://dragfolio.netlify.app,https://your-custom-domain.com
ALLOWED_ORIGINS=https://dragfolio.netlify.app

# Control user registration (yes/no)
# Set to 'yes' to allow new user registration, 'no' to disable
ALLOW_REGISTRATION=yes
